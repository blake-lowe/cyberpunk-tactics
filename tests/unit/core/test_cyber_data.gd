extends TestCase
## Cyberware data (data/rules/cyberware.json, generated by tools/gen_rules_data.py): every piece is
## cited and placed in the slot model, and the market sells only what the game plays (like
## test_gear_data's gate for equipment).

## fx keys the rules code implements (Combatant._cyber_fx, Combatant.install_cyberware, Attack, Weapon).
## A piece may only be sold if all its fx are here.
const IMPLEMENTED_FX := ["stat", "stat_cap", "skill", "initiative", "ignore_seriously_wounded", "armor_sp", "weapon",
	"weapon_quality", "aimed_bonus", "brawling_min_dice",
	# phase 1: the Sandevistan (Encounter.use_chrome), popups (Cyber.popup_weapon), the Popup Shield, the
	# Skill Chip (Combatant.chipped), scanners (kit_skill_bonus), TeleOptics (Attack.long_shot_bonus),
	# Linear Frames (Combatant.raw_stat)
	"initiative_activated", "weapon_choice", "popup", "shield", "skill_chip", "skill_bonus", "long_shot_bonus", "long_shot_m",
	"stat_set",
	# phase 2: senses and hazards (Combatant.sees_through_obscurement, perception_bonus, immune_to,
	# sense_range; Encounter.sight_penalty, obscured_mod, update_reveals)
	"ignore_obscured", "perception_bonus", "immune", "radar_m", "motion_sense_m",
	# phase 3: movement (Nav.climb_free, TurnState.run); phase 4: NET and
	# downtime (NetRun.jack_block, Combatant.rest_heal)
	"climb_free", "jump_free", "run_bonus_m", "netrun", "rest_heal_mult",
	# netrunning gear: the arm's Cyberdeck adds a deck slot (Deck.slots)
	"deck_slots_bonus"]
## Every fx key the data may use: the implemented ones and those waiting for a system.
const KNOWN_FX := IMPLEMENTED_FX
## Phase 1 (combat chrome): each now plays, so each is sold.
const PHASE1 := ["sandevistan", "popup_ranged_weapon", "popup_melee_weapon", "popup_shield", "popup_grenade_launcher", "dartgun",
	"skill_chip", "medscanner", "techscanner", "teleoptics", "implanted_linear_frame_sigma", "implanted_linear_frame_beta",
	"hardened_shielding"]
## Phase 2 (senses and hazards): each now plays, so each is sold, with the Cyberaudio Suite that holds two.
const PHASE2 := ["low_light_infrared_uv", "image_enhance", "amplified_hearing", "anti_dazzle", "level_damper", "nasal_filters",
	"independent_air_supply", "radar_sonar_implant", "tactile_boost", "cyberaudio_suite"]
## Phase 3 (movement), with the Cyberleg that holds the feet; phase 4 (NET and downtime).
const PHASE3 := ["grip_foot", "jump_booster", "skate_foot", "cyberleg"]
const PHASE4 := ["interface_plugs", "enhanced_antibodies"]
## Netrunning gear: the Cyberdeck Cyberarm option (+1 deck slot, p.364).
const DECKS := ["cyberdeck"]
const HOSTS := ["fashion", "neural_link", "chipware", "eye", "cyberaudio", "internal", "external", "arm", "leg", "limb", "borgware"]
## Modelled with no fx of their own: read by the rules by id (teargas: Attack.apply_status; the
## smartgun link: Attack.handling_reason), or foundations that hold a modelled piece.
## Hardened Shielding: Attack.microwaver_targets.
const BY_CODE := ["cybereye", "subdermal_grip", "neural_link", "chipware_socket", "hardened_shielding", "cyberaudio_suite", "cyberleg"]


func test_every_piece_is_cited_and_placed() -> void:
	var db := Cyber.db()
	assert_eq(db.size(), 96, "the book's 96 pieces")
	for id in db:
		var d: Dictionary = db[id]
		assert_true(String(d.get("cite", "")).begins_with("CPR core p."), "%s: cited" % id)
		assert_true(String(d.get("host", "")) in HOSTS, "%s: host %s" % [id, d.get("host")])
		assert_true(d.get("slots") is float or d.get("slots") is int, "%s: slots" % id)
		assert_false(Cyber.locs_for(id).is_empty(), "%s: somewhere to go" % id)
		var need := Cyber.needs(id)
		assert_true(need == "" or Cyber.is_foundation(need) or need == "chipware_socket", "%s: needs a foundation (%s)" % [id, need])
		for k in d.get("fx", {}):
			assert_true(k in KNOWN_FX, "%s: fx key %s is known" % [id, k])
		if d.get("paired", false):
			assert_true(String(d.host) in ["eye", "leg"], "%s: paired in eyes or legs" % id)
	for f in ["neural_link", "cybereye", "cyberaudio_suite", "cyberarm", "cyberleg"]:
		assert_true(Cyber.is_foundation(f), f)


func test_the_market_only_sells_chrome_that_plays() -> void:
	var sold := 0
	for id in Cyber.db():
		var d: Dictionary = Cyber.def(id)
		var key := "cyberware/" + String(id)
		var ch := Cyber.choices(String(id))
		if not ch.is_empty():   # made for one thing: sold made for it, never bare
			assert_false(NightMarket.on_sale(key), "%s: sold only made for something" % id)
			key += "@" + ch[0]
		assert_eq(NightMarket.on_sale(key), Cyber.modelled(id), "%s: on sale exactly when modelled" % id)
		if not Cyber.modelled(id):
			continue
		sold += 1
		assert_false(d.has("unmodelled"), id)
		var fx: Dictionary = d.get("fx", {})
		for k in fx:
			assert_true(k in IMPLEMENTED_FX, "%s is sold, so its fx %s must be implemented" % [id, k])
		assert_true(not fx.is_empty() or id in BY_CODE, "%s is sold, so something plays it" % id)
		var s := Cyber.summary(id)
		assert_false(s.is_empty() or s == String(d.effect), "%s: a Med Bay line of its own" % id)
		assert_false(s.contains(" p.") or s.contains("CPR"), "%s: no cites in player text" % id)
		assert_true(s.split(" ").size() <= 16, "%s: short" % id)
		assert_true(int(d.cost) > 0, "%s: priced" % id)
		var need := Cyber.needs(id)
		assert_true(need == "" or Cyber.modelled(need), "%s: its foundation %s is sold too" % [id, need])
	assert_true(sold >= 12, "at least the twelve pieces sold before (%d)" % sold)
	for id in ["wolvers", "big_knucks", "rippers", "vampyres", "kerenzikov", "targeting_scope"] + PHASE1 + PHASE2 + PHASE3 + PHASE4 + DECKS:
		assert_true(Cyber.modelled(id), "%s plays" % id)
		assert_true(NightMarket.matching({"kind": "cyberware"}).any(func(k): return Items.base_id(k) == id), "%s on sale" % id)
	# Swimming isn't played (the Web Foot).
	for id in ["biomonitor", "radar_detector", "microoptics", "artificial_shoulder_mount", "web_foot"]:
		assert_false(Cyber.modelled(id), "%s waits for its system" % id)
