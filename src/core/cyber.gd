class_name Cyber
extends RefCounted
## The cyberware slot model: where each installed piece sits, how many Option Slots it takes, and
## whether a new piece fits (CPR core p.111-116, full entries p.358-367). Pure static functions over
## an implants list, so the rules, the Med Bay, NPC blocks and the save migration all share them.
##
## An installed piece is a Dictionary {"id": cyberware id, "loc": location}; a character's pieces
## are Combatant.implants (one entry per piece: two Cybereyes are two entries). Locations:
##   fashion, internal, external      no foundation, 7 Option Slots each (p.111)
##   neural_link                      the Neural Link and its options (5 slots, p.359); the Subdermal
##                                    Grip also takes one of these slots though it sits in an arm (p.366)
##   chipware                         chips: no Neural Link slot (p.359), but each Chipware Socket holds
##                                    one chip ("a single piece of Chipware", p.359)
##   right_eye, left_eye              a Cybereye (3 slots each, p.361) and its options
##   cyberaudio                       the Cyberaudio Suite (only one, 3 slots, p.362) and its options
##   right_arm, left_arm              a Cyberarm (4 slots, p.364) and its options; without one the arm
##                                    is meat and takes one meat-arm piece (Wolvers, Big Knucks...) plus
##                                    a Standard Hand, which doesn't count (p.364-366)
##   right_leg, left_leg              a Cyberleg (3 slots, p.366) and its options; a meat leg takes a
##                                    Talon Foot plus a Standard Foot (p.366-367)
##   borgware                         Borgware (p.367): no slots
## Data fields (data/rules/cyberware.json, generated by tools/gen_rules_data.py): host (fashion,
## neural_link, chipware, eye, cyberaudio, internal, external, arm, leg, limb = arm or leg,
## borgware), slots (Option Slots it takes), foundation + capacity (a foundation and the slots it
## holds), needs (the foundation an option needs, "" if none: the market brings it, p.338), paired
## (one in each eye/leg, both bought, Humanity Loss for each; works only with both), meat_ok (fits a
## meat arm/leg as its only piece), free_in_meat (Standard Hand/Foot: doesn't count there), unique
## (one per character), group (one per group: speedware), multi (several may share a host),
## neural_slot (also takes Neural Link slots), summary (the Med Bay line), unmodelled (its effect
## isn't played yet: hidden from players and never sold), cite.
##
## Benefits of several installations of one piece don't stack (p.111): fx count once per id
## (active_ids). Paired options count only when both halves are in and working.

const EYES: Array[String] = ["right_eye", "left_eye"]
const ARMS: Array[String] = ["right_arm", "left_arm"]
const LEGS: Array[String] = ["right_leg", "left_leg"]
## Every location, in the order the Med Bay lists them.
const LOCS: Array[String] = ["neural_link", "chipware", "right_eye", "left_eye", "cyberaudio", "right_arm", "left_arm",
	"right_leg", "left_leg", "internal", "external", "fashion", "borgware"]
## Where each data host can go; the right side first (the save migration's "first Cybereye to the
## right eye").
const HOST_LOCS := {"fashion": ["fashion"], "neural_link": ["neural_link"], "chipware": ["chipware"],
	"eye": ["right_eye", "left_eye"], "cyberaudio": ["cyberaudio"], "internal": ["internal"], "external": ["external"],
	"arm": ["right_arm", "left_arm"], "leg": ["right_leg", "left_leg"],
	"limb": ["right_arm", "left_arm", "right_leg", "left_leg"], "borgware": ["borgware"]}
## Categories with no foundation hold at most 7 Option Slots' worth each (CPR core p.111).
const OPEN_CAPACITY := {"fashion": 7, "internal": 7, "external": 7}
## Player-facing names of the locations.
const LOC_NAMES := {"fashion": "fashionware", "neural_link": "neural link", "chipware": "chipware socket",
	"right_eye": "right eye", "left_eye": "left eye", "cyberaudio": "cyberaudio suite", "right_arm": "right arm",
	"left_arm": "left arm", "right_leg": "right leg", "left_leg": "left leg", "internal": "body",
	"external": "skin", "borgware": "borgware"}


static func db() -> Dictionary:
	return RulesDB.load_json("cyberware.json")["cyberware"]


## The data entry, {} for an unknown id.
static func def(id: String) -> Dictionary:
	return db().get(id, {})


static func display(id: String) -> String:
	return String(def(id).get("name", id))


## Whether the game plays this piece's effect. The single gate for showing a piece to players and
## for selling it (NightMarket.on_sale); unmodelled pieces stay for NPC blocks and recruits.
static func modelled(id: String) -> bool:
	var d := def(id)
	return not d.is_empty() and not d.get("unmodelled", false)


## The Med Bay's one-line description (player text).
static func summary(id: String) -> String:
	var d := def(id)
	return String(d.get("summary", d.get("effect", "")))


## The foundation an option needs ("" for a foundation, an open-category piece or a meat-arm piece).
static func needs(id: String) -> String:
	return String(def(id).get("needs", ""))


static func is_foundation(id: String) -> bool:
	return bool(def(id).get("foundation", false))


## An option: a piece that goes into a foundation (the Night Market's "Cyberware Option" rows).
static func is_option(id: String) -> bool:
	return needs(id) != "" or bool(def(id).get("meat_ok", false))


static func loc_name(loc: String) -> String:
	return String(LOC_NAMES.get(loc, loc.replace("_", " ")))


## Where this piece could go.
static func locs_for(id: String) -> Array[String]:
	var out: Array[String] = []
	out.assign(HOST_LOCS.get(String(def(id).get("host", "")), []))
	return out


## The key a piece goes by in Combatant.cyber_off ("cybereye@left_eye").
static func key(piece: Dictionary) -> String:
	return "%s@%s" % [piece.id, piece.loc]


static func pieces_at(implants: Array, loc: String) -> Array:
	return implants.filter(func(p): return String(p.loc) == loc)


static func count(implants: Array, id: String) -> int:
	return implants.filter(func(p): return String(p.id) == id).size()


## The foundation piece that makes `loc` chrome ("cybereye", "cyberarm"...), "" if it's meat or empty.
static func foundation_at(implants: Array, loc: String) -> String:
	for p in pieces_at(implants, loc):
		if is_foundation(String(p.id)):
			return String(p.id)
	return ""


## Whether an arm or leg location is still meat.
static func is_meat(implants: Array, loc: String) -> bool:
	return (loc in ARMS or loc in LEGS) and foundation_at(implants, loc) == ""


## Option Slots `loc` holds now.
static func capacity(implants: Array, loc: String) -> int:
	if OPEN_CAPACITY.has(loc):
		return int(OPEN_CAPACITY[loc])
	if loc == "chipware":
		return count(implants, "chipware_socket")   # one chip per socket (CPR core p.359)
	var f := foundation_at(implants, loc)
	if f == "":
		return 0
	var cap := int(def(f).get("capacity", 0))
	if loc == "cyberaudio" and count(implants, "sensor_array") > 0:
		cap += 5   # Sensor Array: up to 5 more Cyberaudio Options (CPR core p.367)
	return cap


## Option Slots used at `loc`, counting the Neural Link slot a Subdermal Grip takes from its arm.
static func used(implants: Array, loc: String) -> int:
	var n := 0
	for p in implants:
		var d := def(String(p.id))
		if loc == "chipware" and String(p.loc) == "chipware":
			n += 1
		elif String(p.loc) == loc and not (is_meat(implants, loc)):
			n += int(d.get("slots", 1))
		if loc == "neural_link" and String(p.loc) != "neural_link":
			n += int(d.get("neural_slot", 0))
	return n


static func free_slots(implants: Array, loc: String) -> int:
	return capacity(implants, loc) - used(implants, loc)


## Pieces in a meat arm or leg that count towards its one piece (the Standard Hand/Foot doesn't).
static func meat_pieces(implants: Array, loc: String) -> Array:
	return pieces_at(implants, loc).filter(func(p): return not def(String(p.id)).get("free_in_meat", false))


## Why `id` can't go into `loc` now, in a few plain words ("" if it can). Checks the piece itself, not
## storage or the crew: Campaign.install_block adds those.
static func block(implants: Array, id: String, loc: String) -> String:
	var d := def(id)
	if d.is_empty():
		return "Unknown cyberware"
	var nm := String(d.name)
	var where := loc_name(loc)
	if not loc in locs_for(id):
		return "Doesn't go in the %s" % where
	if d.get("unique", false) and count(implants, id) > 0:
		return "Only one %s" % nm
	var grp := String(d.get("group", ""))
	if grp != "" and implants.any(func(p): return String(def(String(p.id)).get("group", "")) == grp):
		return "Only one %s" % grp
	var here := pieces_at(implants, loc)
	if d.get("foundation", false):
		var f := foundation_at(implants, loc)
		if f != "":
			return "The %s is already a %s" % [where, display(f).to_lower()] if loc in EYES + ARMS + LEGS else "Already installed"
		if not here.is_empty():
			return "Take the %s out of the %s first" % [display(String(here[0].id)), where]
		return ""
	if not d.get("multi", false) and here.any(func(p): return String(p.id) == id):
		return "Already in the %s" % where if loc in EYES + ARMS + LEGS else "Already installed"
	var host := String(d.get("host", ""))
	if d.get("paired", false):
		var pair := EYES if host == "eye" else LEGS
		if pair.any(func(l): return foundation_at(implants, l) == ""):
			return "Needs two %ss" % ("cybereye" if host == "eye" else "cyberleg")
	var nslot := int(d.get("neural_slot", 0))
	if nslot > 0:
		if foundation_at(implants, "neural_link") == "":
			return "Needs a Neural Link"
		if free_slots(implants, "neural_link") < nslot:
			return "No free slot in the neural link"
	if is_meat(implants, loc):
		if not d.get("meat_ok", false):
			return "Needs a %s in the %s" % ["cyberleg" if loc in LEGS else "cyberarm", where]
		if not d.get("free_in_meat", false) and not meat_pieces(implants, loc).is_empty():
			return "The meat %s already holds %s" % [where.get_slice(" ", 1), display(String(meat_pieces(implants, loc)[0].id))]
		return ""
	if d.get("free_in_meat", false):
		return "The %s comes with one" % display(foundation_at(implants, loc)).to_lower()
	if host == "borgware":
		return ""   # no Option Slots (CPR core p.367); what each needs is unchecked while Borgware is unmodelled
	var cap := capacity(implants, loc)
	if cap <= 0:
		match loc:
			"chipware": return "Needs a Chipware Socket"
			"neural_link": return "Needs a Neural Link"
			"cyberaudio": return "Needs a Cyberaudio Suite"
			"right_eye", "left_eye": return "Needs a cybereye in the %s" % where
		return "No room in the %s" % where
	var need := 1 if loc == "chipware" else int(d.get("slots", 1))
	var left := cap - used(implants, loc)
	if left < need:
		if loc == "chipware":
			return "Every chipware socket is full"
		return "No free slot in the %s" % where if left <= 0 else "Needs %d free slots in the %s" % [need, where]
	return ""


## The locations `id` fits now, in HOST_LOCS order.
static func free_locs(implants: Array, id: String) -> Array[String]:
	var out: Array[String] = []
	for l in locs_for(id):
		if block(implants, id, l) == "":
			out.append(l)
	return out


## "" if `id` fits somewhere, else why not (the reason for its first location).
static func block_any(implants: Array, id: String) -> String:
	var locs := locs_for(id)
	if locs.is_empty():
		return "Unknown cyberware" if def(id).is_empty() else "Doesn't fit"
	var first := ""
	for l in locs:
		var why := block(implants, id, l)
		if why == "":
			return ""
		if first == "":
			first = why
	return first


## Where an install with no location named goes: the first free location, a paired option into the
## side that lacks it; "" if it fits nowhere.
static func auto_loc(implants: Array, id: String) -> String:
	var locs := free_locs(implants, id)
	return "" if locs.is_empty() else locs[0]


## Pieces that must come out before `piece` can: what it holds (options in a foundation; chips past
## the sockets left; a Subdermal Grip's Neural Link slot).
static func dependents(implants: Array, piece: Dictionary) -> Array:
	var id := String(piece.id)
	var loc := String(piece.loc)
	var rest: Array = implants.duplicate()
	rest.erase(piece)
	var out: Array = []
	if is_foundation(id):
		out.append_array(pieces_at(rest, loc))
		if id == "neural_link":
			out.append_array(rest.filter(func(p): return int(def(String(p.id)).get("neural_slot", 0)) > 0))
	if id == "chipware_socket" and pieces_at(rest, "chipware").size() > count(rest, "chipware_socket"):
		out.append_array(pieces_at(rest, "chipware"))
	return out


## Why `piece` can't come out now ("" if it can).
static func remove_block(implants: Array, piece: Dictionary) -> String:
	var deps := dependents(implants, piece)
	if deps.is_empty():
		return ""
	return "%s needs it" % display(String(deps[0].id))


## Every piece the effect of which counts now, one id each (benefits don't stack, p.111): installed,
## not knocked out (`off`: Combatant.cyber_off), a paired option only with both halves working.
static func active_ids(implants: Array, off: Dictionary = {}) -> Array[String]:
	var out: Array[String] = []
	for p in implants:
		var id := String(p.id)
		if id in out or int(off.get(key(p), 0)) > 0:
			continue
		if def(id).get("paired", false) and not paired_working(implants, id, off):
			continue
		out.append(id)
	return out


## Whether a paired option is in both eyes (or legs) and neither half is knocked out.
static func paired_working(implants: Array, id: String, off: Dictionary = {}) -> bool:
	var pair := LEGS if String(def(id).get("host", "")) == "leg" else EYES
	for l in pair:
		var ok := false
		for p in pieces_at(implants, l):
			if String(p.id) == id and int(off.get(key(p), 0)) <= 0:
				ok = true
		if not ok:
			return false
	return true


## No meat eyes left (teargas affects "anyone with meat eyes", CPR core p.347).
static func no_meat_eyes(implants: Array) -> bool:
	return EYES.all(func(l): return foundation_at(implants, l) == "cybereye")


## The pieces players may see: modelled ones only (cards, rosters, inspectors, tooltips, debriefs).
static func shown(implants: Array) -> Array:
	return implants.filter(func(p): return modelled(String(p.id)))


## shown() as names, one per piece ("Cybereye", "Cybereye", "Targeting Scope").
static func shown_names(implants: Array) -> Array[String]:
	var out: Array[String] = []
	for p in shown(implants):
		out.append(display(String(p.id)))
	return out


## Order a list of ids so every foundation comes before what it holds (a stat block or Role list may
## name Interface Plugs before the Neural Link): foundations, then Chipware Sockets, then the rest.
static func foundations_first(ids: Array) -> Array[String]:
	var out: Array[String] = []
	for rank in 3:
		for id in ids:
			var r := 0 if is_foundation(String(id)) else 1 if String(id) == "chipware_socket" else 2
			if r == rank:
				out.append(String(id))
	return out


## Where a piece goes when nothing fits but it must go in anyway (a printed stat block, an old
## save): its first location. The book's stat blocks win over the slot rules.
static func fallback_loc(id: String) -> String:
	var locs := locs_for(id)
	return locs[0] if not locs.is_empty() else "borgware"


## Place a flat list of ids (an old save, a stat block) as pieces: foundations first, each where
## auto_loc puts it, else at fallback_loc. Ids the data doesn't know are dropped.
static func place_ids(ids: Array) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for id in foundations_first(ids.filter(func(x): return db().has(String(x)))):
		var loc := auto_loc(out, id)
		out.append({"id": id, "loc": loc if loc != "" else fallback_loc(id)})
	return out
